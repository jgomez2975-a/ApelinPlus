+++ b/Apelin/Interface/Chats/ContextMeterView.swift
@@ -0,0 +1,99 @@
+import UIKit
+
+/// How full the window is, as a line above the composer.
+///
+/// A conversation that is running out of room is worth knowing about before
+/// the message that fails, and this is the one place it can be said without
+/// taking a row: a label, a bar and the two numbers, on the line the keyboard
+/// would otherwise push up against. Tapping it opens the inspector, which is
+/// where the reason lives.
+final class ContextMeterView: UIView {
+    var onTap: (() -> Void)?
+
+    private let label = UILabel()
+    private let track = UIView()
+    private let fill = UIView()
+    private let value = UILabel()
+    private var fraction: CGFloat = 0
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        layer.cornerRadius = 9
+        layer.cornerCurve = .continuous
+
+        label.font = .systemFont(ofSize: 11.5, weight: .semibold)
+        label.setContentHuggingPriority(.required, for: .horizontal)
+        label.setContentCompressionResistancePriority(.required, for: .horizontal)
+        label.text = String(localized: "Context")
+
+        track.layer.cornerRadius = 2
+        track.clipsToBounds = true
+        track.translatesAutoresizingMaskIntoConstraints = false
+        fill.layer.cornerRadius = 2
+        track.addSubview(fill)
+
+        value.font = .monospacedDigitSystemFont(ofSize: 11.5, weight: .semibold)
+        value.setContentHuggingPriority(.required, for: .horizontal)
+        value.setContentCompressionResistancePriority(.required, for: .horizontal)
+
+        let row = UIStackView(arrangedSubviews: [label, track, value])
+        row.axis = .horizontal
+        row.spacing = 8
+        row.alignment = .center
