+    private static func ink(critical: Bool, large: Bool) -> UIColor {
+        if critical { return UIColor(red: 0.70, green: 0.15, blue: 0.12, alpha: 1) }
+        if large { return UIColor(red: 0.64, green: 0.35, blue: 0, alpha: 1) }
+        return UIColor(red: 0.12, green: 0.48, blue: 0.22, alpha: 1)
+    }
