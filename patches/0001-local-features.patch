+            } else {
+                badge.textColor = UIColor(red: 0.12, green: 0.48, blue: 0.22, alpha: 1)
+                badge.backgroundColor = UIColor(red: 0.20, green: 0.78, blue: 0.35, alpha: 0.13)
+            }
+        case let .note(text):
+            badge.isHidden = false
+            badge.text = text
+            badge.textColor = .secondaryLabel
+            badge.backgroundColor = UIColor.tertiarySystemFill
+        }
+        badge.invalidateIntrinsicContentSize()
+    }
+}
diff --git a/Apelin/Interface/Settings/Accounts/ProviderBalance.swift b/Apelin/Interface/Settings/Accounts/ProviderBalance.swift
new file mode 100644
index 0000000..6e29209
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/ProviderBalance.swift
@@ -0,0 +1,169 @@
+import Foundation
+
+/// What an endpoint says is left on the key it was given.
+///
+/// Only the routes that answer a number without a browser session can be
+/// asked: an OpenAI-compatible gateway's billing endpoints, DeepSeek's own
+/// balance and OpenRouter's credits. A relay that keeps balance behind a
+/// login page answers 401 or 404 to the key — that is the route having
+/// nothing to say, not the key being wrong, so it is reported as no balance
+/// rather than as a failed check.
+struct ProviderBalance: Sendable {
+    let remaining: Double
+    let currency: String
+    /// What the key started with, when the endpoint says so.
+    let limit: Double?
+
+    /// `$16.79`, or `$16.79 / $20.00` when the starting amount is known.
+    var described: String {
+        let left = Self.money(remaining, currency: currency)
+        guard let limit, limit > 0 else { return left }
+        return "\(left) / \(Self.money(limit, currency: currency))"
+    }
+
+    private static func money(_ amount: Double, currency: String) -> String {
+        let formatter = NumberFormatter()
+        formatter.numberStyle = .currency
+        formatter.currencyCode = currency
+        formatter.minimumFractionDigits = 2
+        formatter.maximumFractionDigits = 2
+        return formatter.string(from: NSNumber(value: amount)) ?? "\(currency) \(amount)"
+    }
+}
+
+enum ProviderBalanceError: Error {
+    /// The configuration holds no address to ask.
+    case noEndpoint
+    /// The endpoint answered, with nothing this can read as a balance.
+    case unsupported
+}
+
+enum ProviderBalanceLookup {
+    /// Asks `baseURL`'s endpoint what `apiKey` has left.
+    ///
+    /// The host decides which shape to ask for first — DeepSeek and
+    /// OpenRouter answer on paths of their own — and everything else is
+    /// asked the OpenAI billing pair, which most relays forward. Each is
+    /// tried in turn and the first answer wins, so a relay that implements
+    /// one of them is reached whichever it is.
+    static func fetch(baseURL: String, apiKey: String) async throws -> ProviderBalance {
+        let trimmed = baseURL.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let root = root(of: trimmed) else { throw ProviderBalanceError.noEndpoint }
+        let host = (root.host ?? "").lowercased()
+
+        if host.contains("deepseek"), let balance = try? await deepSeek(root: root, key: apiKey) {
+            return balance
+        }
+        if host.contains("openrouter"), let balance = try? await openRouter(root: root, key: apiKey) {
+            return balance
+        }
+        if let balance = try? await openAIBilling(root: root, key: apiKey) {
+            return balance
+        }
+        throw ProviderBalanceError.unsupported
+    }
+
+    /// `https://gateway.example.com/v1` as the site's own origin: billing
+    /// lives beside the API, not under the versioned path the key talks to.
+    private static func root(of baseURL: String) -> URL? {
+        let candidate = baseURL.contains("://") ? baseURL : "https://" + baseURL
+        guard var components = URLComponents(string: candidate),
+              components.host?.isEmpty == false
+        else { return nil }
+        components.path = ""
+        components.query = nil
+        components.fragment = nil
+        return components.url
+    }
+
+    // MARK: - Routes
+
+    private static func openAIBilling(root: URL, key: String) async throws -> ProviderBalance {
+        guard let subscriptionURL = URL(string: "/v1/dashboard/billing/subscription", relativeTo: root) else {
+            throw ProviderBalanceError.noEndpoint
+        }
+        let subscription = try object(of: try await payload(at: subscriptionURL, key: key))
+        let limit = subscription["hard_limit_usd"] as? Double
+            ?? subscription["system_hard_limit_usd"] as? Double
+            ?? 0
+
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        formatter.dateFormat = "yyyy-MM-dd"
+        let now = Date()
+        let start = formatter.string(from: now.addingTimeInterval(-86_400 * 365))
+        let end = formatter.string(from: now.addingTimeInterval(86_400))
+
+        guard var components = URLComponents(
+            url: URL(string: "/v1/dashboard/billing/usage", relativeTo: root) ?? root,
+            resolvingAgainstBaseURL: false,
+        ) else { throw ProviderBalanceError.noEndpoint }
+        components.queryItems = [
+            URLQueryItem(name: "start_date", value: start),
+            URLQueryItem(name: "end_date", value: end),
+        ]
+        guard let usageURL = components.url else { throw ProviderBalanceError.noEndpoint }
+        let usage = try object(of: try await payload(at: usageURL, key: key))
+        // `total_usage` is in cents, the one place OpenAI's billing API is
+        // not in dollars.
+        let used = (usage["total_usage"] as? Double ?? 0) / 100
+
+        guard limit > 0 || used > 0 else { throw ProviderBalanceError.unsupported }
+        return ProviderBalance(remaining: max(0, limit - used), currency: "USD", limit: limit > 0 ? limit : nil)
+    }
+
+    private static func deepSeek(root: URL, key: String) async throws -> ProviderBalance {
+        guard let url = URL(string: "/user/balance", relativeTo: root) else {
+            throw ProviderBalanceError.noEndpoint
+        }
+        let body = try object(of: try await payload(at: url, key: key))
+        guard let infos = body["balance_infos"] as? [[String: Any]],
+              let first = infos.first,
+              let text = first["total_balance"] as? String,
+              let remaining = Double(text)
+        else { throw ProviderBalanceError.unsupported }
+        return ProviderBalance(
+            remaining: remaining,
+            currency: first["currency"] as? String ?? "CNY",
+            limit: nil,
+        )
+    }
+
+    private static func openRouter(root: URL, key: String) async throws -> ProviderBalance {
+        guard let url = URL(string: "/api/v1/credits", relativeTo: root) else {
+            throw ProviderBalanceError.noEndpoint
+        }
+        let body = try object(of: try await payload(at: url, key: key))
+        guard let credits = body["data"] as? [String: Any] else { throw ProviderBalanceError.unsupported }
+        let total = credits["total_credits"] as? Double ?? 0
+        let used = credits["total_usage"] as? Double ?? 0
+        guard total > 0 else { throw ProviderBalanceError.unsupported }
+        return ProviderBalance(remaining: max(0, total - used), currency: "USD", limit: total)
+    }
+
+    // MARK: - Transport
+
+    /// The bytes the endpoint answered with. Returned as `Data` rather than
+    /// parsed here: a `[String: Any]` is not `Sendable`, and handing one back
+    /// across the await would be a concurrency error under Swift 6.
+    private static func payload(at url: URL, key: String) async throws -> Data {
+        var request = URLRequest(url: url)
+        request.httpMethod = "GET"
+        request.timeoutInterval = 20
+        request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse, (200 ..< 300).contains(http.statusCode) else {
+            throw ProviderBalanceError.unsupported
+        }
+        return data
+    }
+
+    private static func object(of data: Data) throws -> [String: Any] {
+        guard let body = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw ProviderBalanceError.unsupported
+        }
+        return body
+    }
+}
diff --git a/Apelin/Interface/Settings/Accounts/ProviderBalanceScreen.swift b/Apelin/Interface/Settings/Accounts/ProviderBalanceScreen.swift
new file mode 100644
index 0000000..68b04e6
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/ProviderBalanceScreen.swift
@@ -0,0 +1,201 @@
+import ApelinProtocol
+import UIKit
+
+/// What one endpoint says is left on its key, in full.
+///
+/// The list draws a pill, which is a number; this draws what the number is
+/// out of, because the same $16.79 means something different on a key
+/// topped up to $20 and on one topped up to $500. A route that keeps a
+/// balance behind a login answers the key with nothing, and that is said as
+/// what it is: no balance to report, not a key that failed.
+final class ProviderBalanceScreen: TableController {
+    private let providerName: String
+    private let baseURL: String
+    private let apiKey: String
+
+    private var balance: ProviderBalance?
+    private var failure: String?
+    private var loading = true
+
+    private enum Row: Hashable {
+        case amount
+        case detail
+        case message
+    }
+
+    private enum Section: Hashable {
+        case balance
+        case message
+    }
+
+    private lazy var dataSource = TableDataSource<Section, Row, Row>(
+        tableView: tableView,
+        identifier: { $0 },
+    ) { [weak self] _, _, row in
+        self?.cell(for: row)
+    }
+
+    @objc dynamic lazy var refreshItem = UIBarButtonItem(
+        title: String(localized: "Refresh"),
+        primaryAction: UIAction { [weak self] _ in self?.load() },
+    )
+
+    init(name: String, baseURL: String, apiKey: String) {
+        providerName = name
+        self.baseURL = baseURL
+        self.apiKey = apiKey
+        super.init(style: .insetGrouped)
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        title = providerName
+        tableView.rowHeight = UITableView.automaticDimension
+        tableView.estimatedRowHeight = 60
+        navigationItem.rightBarButtonItem = refreshItem
+        rebuild()
+        load()
+    }
+
+    @objc private dynamic func load() {
+        loading = true
+        failure = nil
+        rebuild()
+        Task { [weak self] in
+            guard let self else { return }
+            do {
+                let balance = try await ProviderBalanceLookup.fetch(baseURL: baseURL, apiKey: apiKey)
+                self.balance = balance
+                self.failure = nil
+            } catch is ProviderBalanceError {
+                self.balance = nil
+                self.failure = String(localized: "This endpoint does not report a balance.")
+            } catch {
+                self.balance = nil
+                self.failure = error.localizedDescription
+            }
+            self.loading = false
+            self.rebuild()
+        }
+    }
+
+    private func rebuild() {
+        var sections: [(Section, [Row])] = []
+        if let balance {
+            sections.append((.balance, [.amount, .detail]))
+        }
+        if let failure {
+            sections.append((.message, [.message]))
+        } else if loading, balance == nil {
+            sections.append((.message, [.message]))
+        }
+        dataSource.update(sections)
+    }
+
+    private func cell(for row: Row) -> UITableViewCell {
+        switch row {
+        case .amount:
+            return amountCell()
+        case .detail:
+            return detailCell()
+        case .message:
+            return messageCell()
+        }
+    }
+
+    private func amountCell() -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+        var content = UIListContentConfiguration.cell()
+        content.text = balance.map(Self.left) ?? "—"
+        content.textProperties.font = .systemFont(ofSize: 34, weight: .semibold)
+        content.textProperties.alignment = .center
+        content.textProperties.color = .label
+        content.directionalLayoutMargins = NSDirectionalEdgeInsets(top: 22, leading: 16, bottom: 8, trailing: 16)
+        cell.contentConfiguration = content
+        return cell
+    }
+
+    /// What was there to start with, and how much of it is gone: a bar plus
+    /// the two numbers it is drawn from.
+    private func detailCell() -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+
+        let bar = UIProgressView(progressViewStyle: .default)
+        bar.trackTintColor = .tertiarySystemFill
+        bar.progressTintColor = .tintColor
+        bar.layer.cornerRadius = 3
+        bar.layer.masksToBounds = true
+
+        let line = UILabel()
+        line.font = .preferredFont(forTextStyle: .footnote)
+        line.adjustsFontForContentSizeCategory = true
+        line.textColor = .secondaryLabel
+        line.textAlignment = .center
+        line.text = Self.usageLine(balance)
+
+        let stack = UIStackView(arrangedSubviews: [bar, line])
+        stack.axis = .vertical
+        stack.spacing = 10
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        cell.contentView.addSubview(stack)
+        let margins = cell.contentView.layoutMarginsGuide
+        NSLayoutConstraint.activate([
+            stack.leadingAnchor.constraint(equalTo: margins.leadingAnchor),
+            stack.trailingAnchor.constraint(equalTo: margins.trailingAnchor),
+            stack.topAnchor.constraint(equalTo: margins.topAnchor, constant: 2),
+            stack.bottomAnchor.constraint(equalTo: margins.bottomAnchor, constant: -4),
+        ])
+
+        if let balance, let limit = balance.limit, limit > 0 {
+            bar.progress = Float(max(0, min(1, (limit - balance.remaining) / limit)))
+        } else {
+            // nothing to divide by: a bar would be a claim the endpoint never made
+            bar.isHidden = true
+        }
+        return cell
+    }
+
+    private func messageCell() -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+        var content = UIListContentConfiguration.cell()
+        content.text = loading && failure == nil
+            ? String(localized: "Loading…")
+            : failure
+        content.textProperties.color = .secondaryLabel
+        content.textProperties.font = .preferredFont(forTextStyle: .footnote)
+        content.textProperties.alignment = .center
+        content.textProperties.numberOfLines = 0
+        cell.contentConfiguration = content
+        return cell
+    }
+
+    private static func left(_ balance: ProviderBalance) -> String {
+        money(balance.remaining, currency: balance.currency)
+    }
+
+    private static func usageLine(_ balance: ProviderBalance?) -> String {
+        guard let balance else { return "" }
+        guard let limit = balance.limit, limit > 0 else {
+            return money(balance.remaining, currency: balance.currency)
+        }
+        let used = max(0, limit - balance.remaining)
+        return "\(money(used, currency: balance.currency)) / \(money(limit, currency: balance.currency))"
+    }
+
+    private static func money(_ amount: Double, currency: String) -> String {
+        let formatter = NumberFormatter()
+        formatter.numberStyle = .currency
+        formatter.currencyCode = currency
+        formatter.minimumFractionDigits = 2
+        formatter.maximumFractionDigits = 2
+        return formatter.string(from: NSNumber(value: amount)) ?? "\(currency) \(amount)"
+    }
+}
