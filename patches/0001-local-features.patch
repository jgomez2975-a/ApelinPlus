diff --git a/Packages/ApelinAgent/Sources/ApelinAgent/Session/CompactionTuning.swift b/Packages/ApelinAgent/Sources/ApelinAgent/Session/CompactionTuning.swift
new file mode 100644
index 0000000..630c601
--- /dev/null
+++ b/Packages/ApelinAgent/Sources/ApelinAgent/Session/CompactionTuning.swift
@@ -0,0 +1,37 @@
+import Foundation
+
+/// The two numbers a person may want to move, and where they are kept.
+///
+/// Both are read by the session when it decides how hard to shrink a
+/// transcript, and written by the inspector that shows them. They live in
+/// `UserDefaults` rather than in a configuration object because the session
+/// and the screen that changes them are in different modules and neither
+/// should have to own the other to agree on a number.
+public enum CompactionTuning {
+    /// Whether a send that would be refused may fold its tool output to fit.
+    public static let autoTrimKey = "compaction.autoTrim"
+
+    /// The character ceiling a tool result is folded at, the first time.
+    public static let toolOutputLimitKey = "compaction.toolOutputLimit"
+
+    /// On by default: a conversation that cannot be sent is worse than one
+    /// that has lost the middle of a build log.
+    public static var autoTrim: Bool {
+        UserDefaults.standard.object(forKey: autoTrimKey) as? Bool ?? true
+    }
+
+    /// 8000 is the design's first step — large enough to leave a short file
+    /// read alone, small enough to drop a whole build log.
+    public static var toolOutputLimit: Int {
+        let stored = UserDefaults.standard.integer(forKey: toolOutputLimitKey)
+        return stored > 0 ? stored : 8_000
+    }
+
+    /// The steps a failing compaction walks down, widest first, never above
+    /// what was asked for: 1000 is kwwk's own `/shake`, and going below it
+    /// only throws away the last of the output for no gain.
+    public static var retreatSteps: [Int] {
+        let preferred = toolOutputLimit
+        return [preferred, min(2_000, preferred), min(1_000, preferred)]
+    }
+}
