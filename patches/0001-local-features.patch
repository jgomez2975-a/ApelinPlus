diff --git a/Apelin/Interface/Chats/ChatSearchController.swift b/Apelin/Interface/Chats/ChatSearchController.swift
new file mode 100644
index 0000000..94563e2
--- /dev/null
+++ b/Apelin/Interface/Chats/ChatSearchController.swift
@@ -0,0 +1,226 @@
+import SnapKit
+import Then
+import UIKit
+
+/// Looks through the conversation that is open for a line of text.
+///
+/// A session that has run for hours can only be read back by scrolling it,
+/// and the line someone wants is usually far above the newest one. This
+/// lists every message whose text holds the query, with the line the hit
+/// sits on, and opens one as a page that can be copied.
+///
+/// Only what a person or the model wrote is searched: an activity row is a
+/// tool call, and a compaction row is the summary's own prose — neither is a
+/// line anyone remembers reading.
+final class ChatSearchController: UITableViewController, UISearchResultsUpdating {
+    private let messages: [ChatMessage]
+    private var matches: [ChatMessage] = []
+    /// What a row shows: the query with the words around it, cut short, so a
+    /// hit deep inside a long reply is readable without opening it. The query
+    /// itself is marked in it — a row of nine hundred characters with the hit
+    /// somewhere in the middle is not a result anyone can scan.
+    private var excerpts: [UUID: NSAttributedString] = [:]
+    private let search = UISearchController(searchResultsController: nil)
+    private let emptyLabel = UILabel()
+
+    init(messages: [ChatMessage]) {
+        self.messages = messages.filter { $0.role == .user || $0.role == .assistant }
+        super.init(style: .insetGrouped)
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("Use init(messages:)")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        title = String(localized: "Search")
+        tableView.register(UITableViewCell.self, forCellReuseIdentifier: "match")
+        tableView.rowHeight = UITableView.automaticDimension
+        tableView.estimatedRowHeight = 64
+
+        search.searchResultsUpdater = self
+        search.obscuresBackgroundDuringPresentation = false
+        search.searchBar.placeholder = String(localized: "Search")
+        search.searchBar.autocapitalizationType = .none
+        search.searchBar.autocorrectionType = .no
+        search.searchBar.accessibilityLabel = String(localized: "Search")
+        navigationItem.searchController = search
+        navigationItem.hidesSearchBarWhenScrolling = false
+        definesPresentationContext = true
+
+        emptyLabel.text = String(localized: "No Results")
+        emptyLabel.font = .preferredFont(forTextStyle: .body)
+        emptyLabel.adjustsFontForContentSizeCategory = true
+        emptyLabel.textColor = .secondaryLabel
+        emptyLabel.textAlignment = .center
+        emptyLabel.numberOfLines = 0
+        emptyLabel.isHidden = true
+        // The table's own background rather than a subview of it: a label
+        // added to a table view scrolls with the rows, and this one belongs
+        // to the empty page, not to the list.
+        emptyLabel.backgroundColor = .clear
+        tableView.backgroundView = emptyLabel
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        // The page exists to take a query; a reader who opened it and has to
+        // tap the field first is one tap from closing it again instead.
+        search.searchBar.becomeFirstResponder()
+    }
+
+    // MARK: - Searching
+
+    func updateSearchResults(for searchController: UISearchController) {
+        let query = (searchController.searchBar.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty else {
+            matches = []
+            excerpts = [:]
+            emptyLabel.isHidden = true
+            tableView.reloadData()
+            return
+        }
+
+        var found: [ChatMessage] = []
+        var notes: [UUID: NSAttributedString] = [:]
+        for message in messages {
+            guard let range = message.text.range(
+                of: query,
+                options: [.caseInsensitive, .diacriticInsensitive],
+            ) else { continue }
+            found.append(message)
+            notes[message.id] = Self.excerpt(of: message.text, around: range, marking: query)
+        }
+        matches = found
+        excerpts = notes
+        emptyLabel.isHidden = !found.isEmpty
+        tableView.reloadData()
+    }
+
+    /// The words around `range`, at most `limit` characters to each side, on
+    /// one line, with an ellipsis where it was cut and the query marked in it.
+    @MainActor
+    private static func excerpt(
+        of text: String,
+        around range: Range<String.Index>,
+        marking query: String,
+        limit: Int = 90,
+    ) -> NSAttributedString {
+        let lower = text.index(range.lowerBound, offsetBy: -limit, limitedBy: text.startIndex)
+            ?? text.startIndex
+        let upper = text.index(range.upperBound, offsetBy: limit, limitedBy: text.endIndex)
+            ?? text.endIndex
+        var piece = String(text[lower ..< upper])
+            .replacingOccurrences(of: "\n", with: " ")
+            .replacingOccurrences(of: "\t", with: " ")
+        while piece.contains("  ") {
+            piece = piece.replacingOccurrences(of: "  ", with: " ")
+        }
+        piece = piece.trimmingCharacters(in: .whitespaces)
+        if lower > text.startIndex { piece = "…" + piece }
+        if upper < text.endIndex { piece += "…" }
+        return marked(piece, query: query)
+    }
+
+    /// `piece` with every occurrence of `query` picked out.
+    @MainActor
+    private static func marked(_ piece: String, query: String) -> NSAttributedString {
+        let attributed = NSMutableAttributedString(string: piece)
+        guard !query.isEmpty else { return attributed }
+        var remaining = piece.startIndex ..< piece.endIndex
+        while let found = piece.range(
+            of: query,
+            options: [.caseInsensitive, .diacriticInsensitive],
+            range: remaining,
+        ) {
+            attributed.addAttributes(
+                [
+                    .backgroundColor: UIColor.tintColor.withAlphaComponent(0.18),
+                    .foregroundColor: UIColor.tintColor,
+                ],
+                range: NSRange(found, in: piece),
+            )
+            remaining = found.upperBound ..< piece.endIndex
+        }
+        return attributed
+    }
+
+    // MARK: - Listing
+
+    override func numberOfSections(in _: UITableView) -> Int {
+        1
+    }
+
+    override func tableView(_: UITableView, numberOfRowsInSection _: Int) -> Int {
+        matches.count
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = tableView.dequeueReusableCell(withIdentifier: "match", for: indexPath)
+        let message = matches[indexPath.row]
+        var content = cell.defaultContentConfiguration()
+        content.attributedText = excerpts[message.id] ?? NSAttributedString(string: message.text)
+        content.textProperties.numberOfLines = 3
+        content.textProperties.font = .preferredFont(forTextStyle: .body)
+        // which side said it: the same words read differently as a question
+        // and as an answer
+        content.image = UIImage(systemName: message.role == .user ? "person.fill" : "sparkles")
+        content.imageProperties.tintColor = .secondaryLabel
+        content.imageProperties.maximumSize = CGSize(width: 15, height: 15)
+        cell.contentConfiguration = content
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        let message = matches[indexPath.row]
+        navigationController?.pushViewController(
+            ChatSearchTextController(text: message.text),
+            animated: true,
+        )
+    }
+}
+
+/// One message, whole, as a page that can be read and copied.
+final class ChatSearchTextController: UIViewController {
+    private let text: String
+    private let textView = UITextView()
+
+    init(text: String) {
+        self.text = text
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("Use init(text:)")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        title = String(localized: "Contents")
+        view.backgroundColor = .pageBackground
+
+        textView.text = text
+        textView.font = .preferredFont(forTextStyle: .body)
+        textView.adjustsFontForContentSizeCategory = true
+        textView.isEditable = false
+        textView.alwaysBounceVertical = true
+        textView.backgroundColor = .clear
+        textView.textContainerInset = UIEdgeInsets(top: 8, left: 0, bottom: 24, right: 0)
+        view.addSubview(textView)
+        textView.snp.makeConstraints { make in
+            make.edges.equalTo(view.safeAreaLayoutGuide).inset(16)
+        }
+
+        navigationItem.rightBarButtonItem = UIBarButtonItem(
+            image: UIImage(systemName: "doc.on.doc"),
+            primaryAction: UIAction { [weak self] _ in
+                guard let self else { return }
+                UIPasteboard.general.string = text
+            },
+        ).then { $0.accessibilityLabel = String(localized: "Copy") }
+    }
+}
diff --git a/Apelin/Interface/Chats/ContextMeterView.swift b/Apelin/Interface/Chats/ContextMeterView.swift
new file mode 100644
index 0000000..fe375ea
--- /dev/null
+++ b/Apelin/Interface/Chats/ContextMeterView.swift
@@ -0,0 +1,40 @@
+import UIKit
+
+/// How full the window is, as a hairline under the navigation bar.
+///
+/// A conversation that is running out of room is worth knowing about before
+/// the message that fails, and the bar is the one place it can be said
+/// without taking a row. It stays away until half the window is gone: below
+/// that the number is interesting, not actionable.
+final class ContextMeterView: UIView {
+    private let fill = UIView()
+    private var fraction: CGFloat = 0
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        backgroundColor = .clear
+        isUserInteractionEnabled = false
+        clipsToBounds = true
+        addSubview(fill)
+        isHidden = true
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        fill.frame = CGRect(x: 0, y: 0, width: bounds.width * fraction, height: bounds.height)
+    }
+
+    func show(_ usage: ChatContextUsage) {
+        fraction = CGFloat(usage.fraction)
+        isHidden = usage.fraction < 0.5
+        fill.backgroundColor = usage.isCritical
+            ? .systemRed
+            : (usage.isLarge ? .systemOrange : UIColor.tertiaryLabel)
+        setNeedsLayout()
+    }
+}
