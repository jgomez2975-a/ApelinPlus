+import UIKit
+
+/// What a mark says before the name is read: a colour, and one character.
+///
+/// The shape is the design's: a small rounded square, 29 points, filled with a
+/// two-stop gradient that runs corner to corner.
+final class ProviderMarkView: UIView {
+    private let gradient = CAGradientLayer()
+    private let letter = UILabel()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        layer.cornerRadius = 7.5
+        layer.cornerCurve = .continuous
+        layer.masksToBounds = true
+        // the design's hairline, so a pale tone keeps an edge on a pale cell
+        layer.borderWidth = 0.5
+        layer.borderColor = UIColor.black.withAlphaComponent(0.08).cgColor
+
+        gradient.startPoint = CGPoint(x: 0.15, y: 0)
+        gradient.endPoint = CGPoint(x: 0.85, y: 1)
+        layer.addSublayer(gradient)
+
+        letter.font = .systemFont(ofSize: 13, weight: .bold)
+        letter.textColor = .white
+        letter.textAlignment = .center
+        letter.adjustsFontSizeToFitWidth = true
+        letter.minimumScaleFactor = 0.7
+        letter.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(letter)
+        NSLayoutConstraint.activate([
+            letter.centerXAnchor.constraint(equalTo: centerXAnchor),
+            letter.centerYAnchor.constraint(equalTo: centerYAnchor),
+            letter.widthAnchor.constraint(lessThanOrEqualTo: widthAnchor, multiplier: 0.82),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        // a resize must not animate the fill from its old bounds
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        gradient.frame = bounds
+        CATransaction.commit()
+    }
+
+    override var intrinsicContentSize: CGSize {
+        CGSize(width: 29, height: 29)
+    }
+
+    func show(initial: String, tone: ProviderTint.Tone) {
+        letter.text = initial
+        gradient.colors = [tone.top.cgColor, tone.bottom.cgColor]
+    }
+}
+
+/// What a row says about an endpoint's balance once it has been asked.
+enum ProviderBalanceBadge: Equatable {
+    /// Nothing has been asked yet, or there is nothing to ask.
+    case hidden
+    case checking
+    /// A number, and whether it is low enough to read as a warning.
+    case amount(String, low: Bool)
+    /// A word instead of a number: a subscription, or a route that cannot be asked.
+    case note(String)
