+    /// Collapses the tool output a request cannot carry, before the send that
+    /// would be refused for it.
+    ///
+    /// A turn that has read a few big files ends with "context is too large
+    /// and compaction failed: compaction left <n> tokens, above the recovery
+    /// target of <m>". Compaction cannot get that transcript under the target
+    /// by itself: kwwk's planner keeps the whole unanswered turn verbatim, so
+    /// the cut never moves and `maxSummaryAttempts` has nothing to retry —
+    /// every attempt plans the same replacement, and the last one is reported.
+    ///
+    /// The only part of a transcript that can shrink without a model call is
+    /// the tool output, so that is what goes, largest results first: 8000
+    /// characters leaves short reads alone, 2000 takes the medium ones, and
+    /// 1000 is kwwk's own `/shake`. Each step is measured, and the search
+    /// stops as soon as the transcript fits — a conversation that fits is
+    /// never touched, and one that only just overflows loses the least it can.
+    private func foldToolOutputsPastTheInputBudget() {
+        let window = agent.state.model.contextWindow
+        guard window >= 1_024 else { return }
+        // `AgentRequestBudget` (kwwk, internal) answers the same question:
+        // the window minus what generation may claim, a quarter of it on the
+        // routes that put no automatic limit on the wire. `currentUsage`
+        // counts messages only, so the system prompt and the tool
+        // declarations are subtracted here instead.
+        let inputBudget = window - window / 4 - 4_000
+        guard contextUsage.tokens > inputBudget else { return }
+        // the inspector may have turned this off: folding is the last resort
+        // and it costs the tool output for good
+        guard CompactionTuning.autoTrim else { return }
+        for limit in CompactionTuning.retreatSteps {
+            let (shaken, elided) = AgentContextCompactor.shakeToolOutputs(
+                agent.state.messages,
+                keepingUnder: limit,
+            )
+            // No result is that large: a narrower limit catches more, not
+            // fewer, so the smaller steps still get their turn.
+            guard elided > 0 else { continue }
+            agent.state.messages = shaken
+            if contextUsage.tokens <= inputBudget { return }
+        }
+    }
