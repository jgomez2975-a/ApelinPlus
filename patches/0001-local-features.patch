+                presentNotice(title: "Balance", message: "This endpoint does not report a balance.")
+            }
+        }
+    }
 }
diff --git a/Apelin/Interface/Settings/Accounts/ProviderAccountCell.swift b/Apelin/Interface/Settings/Accounts/ProviderAccountCell.swift
new file mode 100644
index 0000000..7d9fe02
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/ProviderAccountCell.swift
@@ -0,0 +1,311 @@
+import UIKit
+
+/// What a mark says before the name is read: a colour, and one character.
+///
+/// The shape is the design's: a small rounded square, 29 points, filled with a
+/// two-stop gradient that runs corner to corner.
+final class ProviderMarkView: UIView {
+    private let gradient = CAGradientLayer()
+    private let letter = UILabel()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        layer.cornerRadius = 7.5
+        layer.cornerCurve = .continuous
+        layer.masksToBounds = true
+        // the design's hairline, so a pale tone keeps an edge on a pale cell
+        layer.borderWidth = 0.5
+        layer.borderColor = UIColor.black.withAlphaComponent(0.08).cgColor
+
+        gradient.startPoint = CGPoint(x: 0.15, y: 0)
+        gradient.endPoint = CGPoint(x: 0.85, y: 1)
+        layer.addSublayer(gradient)
+
+        letter.font = .systemFont(ofSize: 13, weight: .bold)
+        letter.textColor = .white
+        letter.textAlignment = .center
+        letter.adjustsFontSizeToFitWidth = true
+        letter.minimumScaleFactor = 0.7
+        letter.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(letter)
+        NSLayoutConstraint.activate([
+            letter.centerXAnchor.constraint(equalTo: centerXAnchor),
+            letter.centerYAnchor.constraint(equalTo: centerYAnchor),
+            letter.widthAnchor.constraint(lessThanOrEqualTo: widthAnchor, multiplier: 0.82),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        // a resize must not animate the fill from its old bounds
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        gradient.frame = bounds
+        CATransaction.commit()
+    }
+
+    override var intrinsicContentSize: CGSize {
+        CGSize(width: 29, height: 29)
+    }
+
+    func show(initial: String, tone: ProviderTint.Tone) {
+        letter.text = initial
+        gradient.colors = [tone.top.cgColor, tone.bottom.cgColor]
+    }
+}
+
+/// What a row says about an endpoint's balance once it has been asked.
+enum ProviderBalanceBadge: Equatable {
+    /// Nothing has been asked yet, or there is nothing to ask.
+    case hidden
+    case checking
+    /// A number, and whether it is low enough to read as a warning.
+    case amount(String, low: Bool)
+    /// A word instead of a number: a subscription, or a route that cannot be asked.
+    case note(String)
+}
+
+/// A pill with its own padding, which a plain `UILabel` does not have.
+///
+/// `intrinsicContentSize` is overridden rather than the label being wrapped in
+/// a view, so a cell can size itself from one constraint.
+final class ProviderPillLabel: UILabel {
+    var insets = UIEdgeInsets(top: 3, left: 8, bottom: 3, right: 8) {
+        didSet { invalidateIntrinsicContentSize() }
+    }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        font = .systemFont(ofSize: 12.5, weight: .semibold)
+        adjustsFontForContentSizeCategory = false
+        layer.cornerRadius = 7
+        layer.cornerCurve = .continuous
+        layer.masksToBounds = true
+        textAlignment = .center
+        setContentHuggingPriority(.required, for: .horizontal)
+        setContentCompressionResistancePriority(.required, for: .horizontal)
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func drawText(in rect: CGRect) {
+        super.drawText(in: rect.inset(by: insets))
+    }
+
+    override var intrinsicContentSize: CGSize {
+        let size = super.intrinsicContentSize
+        return CGSize(
+            width: size.width + insets.left + insets.right,
+            height: max(20, size.height + insets.top + insets.bottom),
+        )
+    }
+
+    override func sizeThatFits(_ size: CGSize) -> CGSize {
+        let fitted = super.sizeThatFits(size)
+        return CGSize(
+            width: fitted.width + insets.left + insets.right,
+            height: max(20, fitted.height + insets.top + insets.bottom),
+        )
+    }
+}
+
+/// The word that says which shelf an endpoint sits on, drawn next to the name.
+///
+/// A dot carries the endpoint's own colour so the chip is read with the mark
+/// rather than as a second label: two relays both marked `Relay` are told
+/// apart by the dot before the text is read.
+final class ProviderGroupChip: UIView {
+    private let dot = UIView()
+    private let text = UILabel()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        layer.cornerRadius = 6
+        layer.cornerCurve = .continuous
+        setContentHuggingPriority(.required, for: .horizontal)
+        setContentCompressionResistancePriority(.required, for: .horizontal)
+
+        dot.layer.cornerRadius = 3
+        dot.translatesAutoresizingMaskIntoConstraints = false
+        NSLayoutConstraint.activate([
+            dot.widthAnchor.constraint(equalToConstant: 6),
+            dot.heightAnchor.constraint(equalToConstant: 6),
+        ])
+
+        text.font = .systemFont(ofSize: 11.5, weight: .semibold)
+        text.setContentCompressionResistancePriority(.required, for: .horizontal)
+
+        let row = UIStackView(arrangedSubviews: [dot, text])
+        row.axis = .horizontal
+        row.alignment = .center
+        row.spacing = 5
+        row.isUserInteractionEnabled = false
+        row.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(row)
+        NSLayoutConstraint.activate([
+            row.leadingAnchor.constraint(equalTo: leadingAnchor, constant: 7),
+            row.trailingAnchor.constraint(equalTo: trailingAnchor, constant: -7),
+            row.centerYAnchor.constraint(equalTo: centerYAnchor),
+            heightAnchor.constraint(equalToConstant: 20),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    func show(_ title: String?, tone: ProviderTint.Tone) {
+        guard let title, !title.isEmpty else {
+            isHidden = true
+            return
+        }
+        isHidden = false
+        text.text = title
+        text.textColor = tone.ink
+        dot.backgroundColor = tone.top
+        backgroundColor = tone.wash
+        isAccessibilityElement = true
+        accessibilityLabel = title
+    }
+}
+
+/// One provider in Settings ▸ Model Providers.
+///
+/// The design's row: the mark, the name it answers to with its group beside it
+/// and its host underneath, then — at the end, where the eye goes to compare —
+/// what is left on the key. The `…` menu is the table's accessory, set by the
+/// controller.
+final class ProviderAccountCell: UITableViewCell {
+    static let reuseIdentifier = "ProviderAccountCell"
+
+    private let mark = ProviderMarkView()
+    private let title = UILabel()
+    private let subtitle = UILabel()
+    private let group = ProviderGroupChip()
+    private let balance = ProviderPillLabel()
+    private let titleRow = UIStackView()
+    private let texts = UIStackView()
+    private let row = UIStackView()
+
+    override init(style: UITableViewCell.CellStyle, reuseIdentifier: String?) {
+        super.init(style: style, reuseIdentifier: reuseIdentifier)
+
+        // 16.5pt at -0.28 tracking is the design's row title; a text style
+        // would move with Dynamic Type and break the fixed 56pt row it sits in
+        title.font = .systemFont(ofSize: 16.5)
+        title.adjustsFontForContentSizeCategory = false
+        title.numberOfLines = 1
+        title.lineBreakMode = .byTruncatingTail
+        title.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+
+        subtitle.font = .systemFont(ofSize: 13)
+        subtitle.adjustsFontForContentSizeCategory = false
+        subtitle.textColor = .secondaryLabel
+        subtitle.numberOfLines = 1
+        subtitle.lineBreakMode = .byTruncatingTail
+        subtitle.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+
+        balance.isHidden = true
+
+        titleRow.axis = .horizontal
+        titleRow.alignment = .center
+        titleRow.spacing = 6
+        titleRow.addArrangedSubview(title)
+        titleRow.addArrangedSubview(group)
+        titleRow.addArrangedSubview(UIView())
+
+        texts.axis = .vertical
+        texts.spacing = 2
+        texts.addArrangedSubview(titleRow)
+        texts.addArrangedSubview(subtitle)
+
+        row.axis = .horizontal
+        row.alignment = .center
+        row.spacing = 12
+        row.addArrangedSubview(mark)
+        row.addArrangedSubview(texts)
+        row.addArrangedSubview(balance)
+
+        contentView.addSubview(row)
+        row.translatesAutoresizingMaskIntoConstraints = false
+        NSLayoutConstraint.activate([
+            mark.widthAnchor.constraint(equalToConstant: 29),
+            mark.heightAnchor.constraint(equalToConstant: 29),
+            row.leadingAnchor.constraint(equalTo: contentView.leadingAnchor, constant: 14),
+            row.trailingAnchor.constraint(equalTo: contentView.trailingAnchor, constant: -2),
+            row.topAnchor.constraint(equalTo: contentView.topAnchor, constant: 10),
+            row.bottomAnchor.constraint(equalTo: contentView.bottomAnchor, constant: -10),
+            contentView.heightAnchor.constraint(greaterThanOrEqualToConstant: 56),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func prepareForReuse() {
+        super.prepareForReuse()
+        balance.isHidden = true
+        balance.text = nil
+        group.isHidden = true
+    }
+
+    /// Draws the row. `detail` is the host (or who is signed in), `initial`
+    /// and `tone` are the mark, `group` is the shelf it sits on, and `balance`
+    /// arrives later for a row whose endpoint is being asked.
+    func show(
+        title name: String,
+        detail: String,
+        initial: String,
+        tone: ProviderTint.Tone,
+        group groupTitle: String? = nil,
+        balance badge: ProviderBalanceBadge = .hidden,
+    ) {
+        title.text = name
+        subtitle.text = detail
+        subtitle.isHidden = detail.isEmpty
+        mark.show(initial: initial, tone: tone)
+        group.show(groupTitle, tone: tone)
+        show(badge)
+    }
+
+    /// Fills in the balance pill without touching the rest of the row, so a
+    /// slow endpoint does not redraw the name under the finger.
+    func show(_ badge: ProviderBalanceBadge) {
+        switch badge {
+        case .hidden:
+            balance.isHidden = true
+        case .checking:
+            balance.isHidden = false
+            balance.text = "···"
+            balance.textColor = .secondaryLabel
+            balance.backgroundColor = UIColor.tertiarySystemFill
+        case let .amount(text, low):
+            balance.isHidden = false
+            balance.text = text
+            if low {
+                balance.textColor = UIColor(red: 0.64, green: 0.35, blue: 0, alpha: 1)
+                balance.backgroundColor = UIColor(red: 1, green: 0.58, blue: 0, alpha: 0.15)
+            } else {
+                balance.textColor = UIColor(red: 0.12, green: 0.48, blue: 0.22, alpha: 1)
+                balance.backgroundColor = UIColor(red: 0.20, green: 0.78, blue: 0.35, alpha: 0.13)
+            }
+        case let .note(text):
+            balance.isHidden = false
+            balance.text = text
+            balance.textColor = .secondaryLabel
+            balance.backgroundColor = UIColor.tertiarySystemFill
+        }
+        balance.invalidateIntrinsicContentSize()
+    }
+}
diff --git a/Apelin/Interface/Settings/Accounts/ProviderBalance.swift b/Apelin/Interface/Settings/Accounts/ProviderBalance.swift
new file mode 100644
index 0000000..49f1bd1
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/ProviderBalance.swift
@@ -0,0 +1,236 @@
+import Foundation
+
+/// What an endpoint says is left on the key it was given.
+///
+/// Only the routes that answer a number without a browser session can be
+/// asked: an OpenAI-compatible gateway's billing endpoints, DeepSeek's own
+/// balance and OpenRouter's credits. A relay that keeps balance behind a
+/// login page answers 401 or 404 to the key — that is the route having
+/// nothing to say, not the key being wrong, so it is reported as no balance
+/// rather than as a failed check.
+struct ProviderBalance: Sendable {
+    let remaining: Double
+    let currency: String
+    /// What the key started with, when the endpoint says so.
+    let limit: Double?
+    /// The path that answered, so the detail page can say what was asked and
+    /// a person can check it against the endpoint's own docs.
+    var route: String? = nil
+
+    /// `$16.79`, or `$16.79 / $20.00` when the starting amount is known.
+    var described: String {
+        let left = Self.money(remaining, currency: currency)
+        guard let limit, limit > 0 else { return left }
+        return "\(left) / \(Self.money(limit, currency: currency))"
+    }
+
+    private static func money(_ amount: Double, currency: String) -> String {
+        let formatter = NumberFormatter()
+        formatter.numberStyle = .currency
+        formatter.currencyCode = currency
+        formatter.minimumFractionDigits = 2
+        formatter.maximumFractionDigits = 2
+        return formatter.string(from: NSNumber(value: amount)) ?? "\(currency) \(amount)"
+    }
+}
+
+enum ProviderBalanceError: Error {
+    /// The configuration holds no address to ask.
+    case noEndpoint
+    /// The endpoint answered, with nothing this can read as a balance.
+    case unsupported
+}
+
+enum ProviderBalanceLookup {
+    /// Asks `baseURL`'s endpoint what `apiKey` has left.
+    ///
+    /// `using` is the protocol picked in the endpoint's form. `auto` reads the
+    /// host — DeepSeek and OpenRouter answer on paths of their own — and then
+    /// tries the OpenAI billing pair, which most relays forward; the rest go
+    /// straight to the one route they name, which is what someone picks it
+    /// for when the guessing lands on the wrong answer.
+    static func fetch(
+        baseURL: String,
+        apiKey: String,
+        using picked: String = ProviderBalanceProtocol.automatic,
+    ) async throws -> ProviderBalance {
+        let trimmed = baseURL.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let root = root(of: trimmed) else { throw ProviderBalanceError.noEndpoint }
+        let host = (root.host ?? "").lowercased()
+
+        switch picked {
+        case ProviderBalanceProtocol.newAPI, ProviderBalanceProtocol.oneAPI:
+            if let balance = try? await newAPI(root: root, key: apiKey) { return balance }
+            throw ProviderBalanceError.unsupported
+        case ProviderBalanceProtocol.deepSeek:
+            return try await deepSeek(root: root, key: apiKey)
+        case ProviderBalanceProtocol.openRouter:
+            return try await openRouter(root: root, key: apiKey)
+        case ProviderBalanceProtocol.openAI:
+            return try await openAIBilling(root: root, key: apiKey)
+        default:
+            break
+        }
+
+        if host.contains("deepseek"), let balance = try? await deepSeek(root: root, key: apiKey) {
+            return balance
+        }
+        if host.contains("openrouter"), let balance = try? await openRouter(root: root, key: apiKey) {
+            return balance
+        }
+        // the pair New-API and One-API both implement, which is what most
+        // relays in front of them forward
+        if let balance = try? await newAPI(root: root, key: apiKey) {
+            return balance
+        }
+        if let balance = try? await openAIBilling(root: root, key: apiKey) {
+            return balance
+        }
+        throw ProviderBalanceError.unsupported
+    }
+
+    /// `https://gateway.example.com/v1` as the site's own origin: billing
+    /// lives beside the API, not under the versioned path the key talks to.
+    private static func root(of baseURL: String) -> URL? {
+        let candidate = baseURL.contains("://") ? baseURL : "https://" + baseURL
+        guard var components = URLComponents(string: candidate),
+              components.host?.isEmpty == false
+        else { return nil }
+        components.path = ""
+        components.query = nil
+        components.fragment = nil
+        return components.url
+    }
+
+    // MARK: - Routes
+
+    /// New-API and One-API, which is what most relays here actually run.
+    ///
+    /// `quota` counts in 1/500000 of a dollar — the unit both projects use
+    /// internally — and `used_quota` is what has been spent against it, so the
+    /// pair gives both the remainder and the ceiling.
+    private static func newAPI(root: URL, key: String) async throws -> ProviderBalance {
+        guard let url = URL(string: "/api/user/self", relativeTo: root) else {
+            throw ProviderBalanceError.noEndpoint
+        }
+        let body = try object(of: try await payload(at: url, key: key))
+        guard let user = body["data"] as? [String: Any] else { throw ProviderBalanceError.unsupported }
+        let quota = number(user["quota"])
+        let used = number(user["used_quota"])
+        let total = (quota + used) / 500_000
+        // a key with nothing on it either way is not a balance anyone can use
+        guard total > 0 else { throw ProviderBalanceError.unsupported }
+        return ProviderBalance(
+            remaining: max(0, quota / 500_000),
+            currency: "USD",
+            limit: total,
+            route: "/api/user/self",
+        )
+    }
+
+    private static func openAIBilling(root: URL, key: String) async throws -> ProviderBalance {
+        guard let subscriptionURL = URL(string: "/v1/dashboard/billing/subscription", relativeTo: root) else {
+            throw ProviderBalanceError.noEndpoint
+        }
+        let subscription = try object(of: try await payload(at: subscriptionURL, key: key))
+        let limit = subscription["hard_limit_usd"] as? Double
+            ?? subscription["system_hard_limit_usd"] as? Double
+            ?? 0
+
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        formatter.dateFormat = "yyyy-MM-dd"
+        let now = Date()
+        let start = formatter.string(from: now.addingTimeInterval(-86_400 * 365))
+        let end = formatter.string(from: now.addingTimeInterval(86_400))
+
+        guard var components = URLComponents(
+            url: URL(string: "/v1/dashboard/billing/usage", relativeTo: root) ?? root,
+            resolvingAgainstBaseURL: false,
+        ) else { throw ProviderBalanceError.noEndpoint }
+        components.queryItems = [
+            URLQueryItem(name: "start_date", value: start),
+            URLQueryItem(name: "end_date", value: end),
+        ]
+        guard let usageURL = components.url else { throw ProviderBalanceError.noEndpoint }
+        let usage = try object(of: try await payload(at: usageURL, key: key))
+        // `total_usage` is in cents, the one place OpenAI's billing API is
+        // not in dollars.
+        let used = (usage["total_usage"] as? Double ?? 0) / 100
+
+        guard limit > 0 || used > 0 else { throw ProviderBalanceError.unsupported }
+        return ProviderBalance(
+            remaining: max(0, limit - used),
+            currency: "USD",
+            limit: limit > 0 ? limit : nil,
+            route: "/v1/dashboard/billing/subscription",
+        )
+    }
+
+    private static func deepSeek(root: URL, key: String) async throws -> ProviderBalance {
+        guard let url = URL(string: "/user/balance", relativeTo: root) else {
+            throw ProviderBalanceError.noEndpoint
+        }
+        let body = try object(of: try await payload(at: url, key: key))
+        guard let infos = body["balance_infos"] as? [[String: Any]],
+              let first = infos.first,
+              let text = first["total_balance"] as? String,
+              let remaining = Double(text)
+        else { throw ProviderBalanceError.unsupported }
+        return ProviderBalance(
+            remaining: remaining,
+            currency: first["currency"] as? String ?? "CNY",
+            limit: nil,
+            route: "/user/balance",
+        )
+    }
+
+    private static func openRouter(root: URL, key: String) async throws -> ProviderBalance {
+        guard let url = URL(string: "/api/v1/credits", relativeTo: root) else {
+            throw ProviderBalanceError.noEndpoint
+        }
+        let body = try object(of: try await payload(at: url, key: key))
+        guard let credits = body["data"] as? [String: Any] else { throw ProviderBalanceError.unsupported }
+        let total = credits["total_credits"] as? Double ?? 0
+        let used = credits["total_usage"] as? Double ?? 0
+        guard total > 0 else { throw ProviderBalanceError.unsupported }
+        return ProviderBalance(
+            remaining: max(0, total - used),
+            currency: "USD",
+            limit: total,
+            route: "/api/v1/credits",
+        )
+    }
+
+    // MARK: - Transport
+
+    /// The bytes the endpoint answered with. Returned as `Data` rather than
+    /// parsed here: a `[String: Any]` is not `Sendable`, and handing one back
+    /// across the await would be a concurrency error under Swift 6.
+    private static func payload(at url: URL, key: String) async throws -> Data {
+        var request = URLRequest(url: url)
+        request.httpMethod = "GET"
+        request.timeoutInterval = 20
+        request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse, (200 ..< 300).contains(http.statusCode) else {
+            throw ProviderBalanceError.unsupported
+        }
+        return data
+    }
+
+    /// JSON numbers arrive as `Int` or `Double` depending on the value, and
+    /// both projects this reads send a mix.
+    private static func number(_ value: Any?) -> Double {
+        (value as? NSNumber)?.doubleValue ?? 0
+    }
+
+    private static func object(of data: Data) throws -> [String: Any] {
+        guard let body = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw ProviderBalanceError.unsupported
+        }
+        return body
+    }
+}
diff --git a/Apelin/Interface/Settings/Accounts/ProviderBalanceHistory.swift b/Apelin/Interface/Settings/Accounts/ProviderBalanceHistory.swift
new file mode 100644
index 0000000..a7bd137
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/ProviderBalanceHistory.swift
@@ -0,0 +1,119 @@
+import Foundation
+
+/// What an endpoint's balance was on a given day.
+///
+/// Kept because the only useful thing to say about a remaining amount is how
+/// fast it is going: a bar per day is what turns `¥42.80` into a burn rate.
+/// One entry per day, overwritten as the day goes on.
+struct ProviderBalanceSnapshot: Codable, Equatable {
+    /// `yyyy-MM-dd` in the device's own calendar: a day is what the person
+    /// reading it calls a day.
+    let day: String
+    let remaining: Double
+    let currency: String
+}
+
+enum ProviderBalanceHistory {
+    private static let storageKey = "provider.balance.history"
+    /// A week is what the chart draws; a fortnight is kept so a week is still
+    /// there after a few days of not opening this screen.
+    private static let keepDays = 14
+
+    private static var all: [String: [ProviderBalanceSnapshot]] {
+        guard let data = UserDefaults.standard.data(forKey: storageKey),
+              let decoded = try? JSONDecoder().decode([String: [ProviderBalanceSnapshot]].self, from: data)
+        else { return [:] }
+        return decoded
+    }
+
+    /// Writes today's answer over today's entry, so opening this screen twice
+    /// does not draw the same day twice.
+    static func record(_ balance: ProviderBalance, for rawValue: String) {
+        var every = all
+        var entries = every[rawValue] ?? []
+        let today = Self.dayKey(for: Date())
+        let snapshot = ProviderBalanceSnapshot(
+            day: today,
+            remaining: balance.remaining,
+            currency: balance.currency,
+        )
+        if let index = entries.firstIndex(where: { $0.day == today }) {
+            entries[index] = snapshot
+        } else {
+            entries.append(snapshot)
+        }
+        entries.sort { $0.day < $1.day }
+        if entries.count > keepDays {
+            entries.removeFirst(entries.count - keepDays)
+        }
+        every[rawValue] = entries
+        guard let data = try? JSONEncoder().encode(every) else { return }
+        UserDefaults.standard.set(data, forKey: storageKey)
+    }
+
+    /// The last `days` days, oldest first, with a `nil` for a day nothing was
+    /// recorded — a gap is a gap, not a zero.
+    static func recent(_ rawValue: String, days: Int) -> [ProviderBalanceSnapshot?] {
+        let entries = all[rawValue] ?? []
+        let byDay = Dictionary(entries.map { ($0.day, $0) }, uniquingKeysWith: { _, last in last })
+        let calendar = Calendar.current
+        let today = calendar.startOfDay(for: Date())
+        return (0 ..< days).reversed().map { offset in
+            guard let date = calendar.date(byAdding: .day, value: -offset, to: today) else { return nil }
+            return byDay[Self.dayKey(for: date)]
+        }
+    }
+
+    /// What was spent today, when yesterday is known. `nil` on the first day,
+    /// where there is nothing to compare against and a guess would be worse
+    /// than a dash.
+    static func spentToday(_ rawValue: String) -> Double? {
+        let entries = all[rawValue] ?? []
+        let calendar = Calendar.current
+        let today = calendar.startOfDay(for: Date())
+        guard let yesterday = calendar.date(byAdding: .day, value: -1, to: today),
+              let previous = entries.first(where: { $0.day == Self.dayKey(for: yesterday) }),
+              let current = entries.first(where: { $0.day == Self.dayKey(for: today) })
+        else { return nil }
+        return max(0, previous.remaining - current.remaining)
+    }
+
+    /// What was spent since the first of the month, over whatever days of it
+    /// are known: the first entry of the month against the last.
+    static func spentThisMonth(_ rawValue: String) -> Double? {
+        let entries = all[rawValue] ?? []
+        let calendar = Calendar.current
+        let now = Date()
+        guard let firstOfMonth = calendar.date(from: calendar.dateComponents([.year, .month], from: now))
+        else { return nil }
+        let thisMonth = entries.filter { entry in
+            guard let date = Self.date(from: entry.day) else { return false }
+            return date >= calendar.startOfDay(for: firstOfMonth)
+        }
+        guard thisMonth.count >= 2, let first = thisMonth.first, let last = thisMonth.last else { return nil }
+        return max(0, first.remaining - last.remaining)
+    }
+
+    /// `11/10` — the design's axis label, short enough for seven of them.
+    static func axisLabel(for offsetFromToday: Int) -> String {
+        let calendar = Calendar.current
+        guard let date = calendar.date(byAdding: .day, value: -offsetFromToday, to: Date()) else { return "" }
+        let formatter = DateFormatter()
+        formatter.setLocalizedDateFormatFromTemplate("Md")
+        return formatter.string(from: date)
+    }
+
+    private static func dayKey(for date: Date) -> String {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.dateFormat = "yyyy-MM-dd"
+        return formatter.string(from: date)
+    }
+
+    private static func date(from key: String) -> Date? {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.dateFormat = "yyyy-MM-dd"
+        return formatter.date(from: key)
+    }
+}
diff --git a/Apelin/Interface/Settings/Accounts/ProviderBalanceScreen.swift b/Apelin/Interface/Settings/Accounts/ProviderBalanceScreen.swift
