diff --git a/Apelin/Interface/Settings/Accounts/ProviderMeta.swift b/Apelin/Interface/Settings/Accounts/ProviderMeta.swift
new file mode 100644
index 0000000..ec0f071
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/ProviderMeta.swift
@@ -0,0 +1,111 @@
+import Foundation
+
+/// What an endpoint carries beyond its credential: the group it sits in, and
+/// how its balance is meant to be asked for.
+///
+/// None of this is a secret and none of it belongs to apelin-agent: a group is
+/// a word the person picked, a protocol is a choice about a request this app
+/// makes itself. So it lives in `UserDefaults`, keyed by the endpoint's
+/// `rawValue`, beside the name and the colour — and out of the keychain, which
+/// holds the one thing that must not be written twice.
+struct ProviderMeta: Codable, Equatable {
+    /// Which shelf the endpoint sits on: `Primary`, `Backup`, `Relay`,
+    /// `Official`, or nothing at all. Also what the row's chip says.
+    var group: String?
+
+    /// Whether this screen may ask the endpoint for a balance at all. A relay
+    /// that rate-limits, or a key that is metered elsewhere, is asked nothing
+    /// once this is off.
+    var balanceEnabled: Bool = true
+
+    /// Which billing shape to ask for. `auto` reads the host and tries in
+    /// turn, which is what most endpoints need; the rest skip the guessing.
+    var balanceProtocol: String = ProviderBalanceProtocol.automatic
+
+    /// How often a balance is asked for again, in minutes. `0` never.
+    var refreshMinutes: Int = 30
+
+    /// Under this, the row's pill turns amber and the detail page says the
+    /// key is running out.
+    var warnThreshold: Double = 5
+}
+
+enum ProviderMetaStore {
+    private static let storageKey = "provider.meta"
+
+    /// Everything stored, parsed once per call: the list is short enough that
+    /// caching it would only be a second place for it to be wrong.
+    private static var all: [String: ProviderMeta] {
+        guard let data = UserDefaults.standard.data(forKey: storageKey),
+              let decoded = try? JSONDecoder().decode([String: ProviderMeta].self, from: data)
+        else { return [:] }
+        return decoded
+    }
+
+    static func meta(for rawValue: String) -> ProviderMeta {
+        all[rawValue] ?? ProviderMeta()
+    }
+
+    static func set(_ meta: ProviderMeta, for rawValue: String) {
+        var every = all
+        every[rawValue] = meta
+        guard let data = try? JSONEncoder().encode(every) else { return }
+        UserDefaults.standard.set(data, forKey: storageKey)
+    }
+
+    /// Edits in place, so a change to one field does not have to spell out
+    /// the other four and risk resetting them to their defaults.
+    static func update(_ rawValue: String, _ body: (inout ProviderMeta) -> Void) {
+        var meta = meta(for: rawValue)
+        body(&meta)
+        set(meta, for: rawValue)
+    }
+}
+
+/// The billing shapes this app knows how to ask for.
+enum ProviderBalanceProtocol {
+    static let automatic = "auto"
+    static let newAPI = "newapi"
+    static let oneAPI = "oneapi"
+    static let openRouter = "openrouter"
+    static let deepSeek = "deepseek"
+    static let openAI = "openai"
+
+    /// In the order the picker shows them: automatic first, because it is what
+    /// almost every endpoint wants.
+    static let all = [automatic, newAPI, oneAPI, openRouter, deepSeek, openAI]
+
+    static func title(_ value: String) -> String {
+        switch value {
+        case newAPI: String(localized: "New-API Standard")
+        case oneAPI: String(localized: "One-API Standard")
+        case openRouter: String(localized: "OpenRouter Credits")
+        case deepSeek: String(localized: "DeepSeek Balance")
+        case openAI: String(localized: "OpenAI Billing")
+        default: String(localized: "Automatic")
+        }
+    }
+}
+
+/// The groups the design offers, in the order it lists them. A group is only
+/// a word on a chip and a heading — nothing branches on it.
+enum ProviderGroup {
+    static let primary = "Primary"
+    static let backup = "Backup"
+    static let relay = "Relay"
+    static let official = "Official"
+
+    static let all = [primary, backup, relay, official]
+
+    /// The word as it is written on the row.
+    static func title(_ value: String?) -> String? {
+        guard let value, !value.isEmpty else { return nil }
+        switch value {
+        case primary: return String(localized: "Primary")
+        case backup: return String(localized: "Backup")
+        case relay: return String(localized: "Relay")
+        case official: return String(localized: "Official")
+        default: return value
+        }
+    }
+}
diff --git a/Apelin/Interface/Settings/Accounts/ProviderTint.swift b/Apelin/Interface/Settings/Accounts/ProviderTint.swift
new file mode 100644
index 0000000..070d59a
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/ProviderTint.swift
@@ -0,0 +1,92 @@
+import UIKit
+
+/// The colour a provider carries in the list.
+///
+/// The list exists to tell several relays apart, and the mark every
+/// OpenAI-compatible endpoint shares does not do that: three of them in a row
+/// are the same square logo three times, and the host underneath is small
+/// enough that reading it is the only way to pick the right one. A colour and
+/// the first character of the name are readable before the name is.
+///
+/// A provider that has not been given a colour takes one by its `rawValue`,
+/// stably: the same endpoint keeps the same colour between launches, and two
+/// endpoints next to each other almost never share one.
+enum ProviderTint {
+    struct Tone {
+        let top: UIColor
+        let bottom: UIColor
+
+        /// Behind a badge's text.
+        var wash: UIColor { top.withAlphaComponent(0.15) }
+        /// The badge's text: the darker end, so it reads on `wash`.
+        var ink: UIColor { bottom }
+    }
+
+    /// The five the design draws with, in the order they are handed out.
+    static let palette: [Tone] = [
+        Tone(top: color(0x5B8DEF), bottom: color(0x3E5FD6)),
+        Tone(top: color(0xF0993F), bottom: color(0xD9701F)),
+        Tone(top: color(0x34C759), bottom: color(0x1E9E43)),
+        Tone(top: color(0xAF7AEF), bottom: color(0x7B4FD6)),
+        Tone(top: color(0x8E8E93), bottom: color(0x636366)),
+    ]
+
+    /// The tone `rawValue` picks for itself.
+    ///
+    /// A stable sum, not `hashValue`: Swift seeds its hashing per process, so
+    /// a provider would change colour on every launch.
+    static func tone(for rawValue: String) -> Tone {
+        palette[automaticIndex(for: rawValue)]
+    }
+
+    private static func automaticIndex(for rawValue: String) -> Int {
+        var sum = 0
+        for scalar in rawValue.unicodeScalars {
+            sum = (sum &* 31 &+ Int(scalar.value)) % 1_000_003
+        }
+        return sum % palette.count
+    }
+
+    // MARK: - Choosing one
+
+    private static let selectionKey = "provider.tones"
+
+    private static var selections: [String: Int] {
+        UserDefaults.standard.dictionary(forKey: selectionKey) as? [String: Int] ?? [:]
+    }
+
+    /// The colour chosen for `rawValue`, when one was. `nil` means the
+    /// endpoint takes the one it picks for itself.
+    static func chosenIndex(for rawValue: String) -> Int? {
+        guard let index = selections[rawValue], palette.indices.contains(index) else { return nil }
+        return index
+    }
+
+    /// The tone `rawValue` draws: the one it was given, or its own.
+    static func resolvedTone(for rawValue: String) -> Tone {
+        guard let index = chosenIndex(for: rawValue) else { return tone(for: rawValue) }
+        return palette[index]
+    }
+
+    /// Gives `rawValue` a colour; `nil` hands it back to the automatic one.
+    static func choose(_ index: Int?, for rawValue: String) {
+        var all = selections
+        all[rawValue] = index.flatMap { palette.indices.contains($0) ? $0 : nil }
+        UserDefaults.standard.set(all, forKey: selectionKey)
+    }
+
+    /// The character a mark draws: one letter, in the case a name is written.
+    static func initial(for name: String) -> String {
+        guard let first = name.first(where: { !$0.isWhitespace }) else { return "?" }
+        return String(first).uppercased()
+    }
+
+    private static func color(_ hex: UInt32) -> UIColor {
+        UIColor(
+            red: CGFloat((hex >> 16) & 0xFF) / 255,
+            green: CGFloat((hex >> 8) & 0xFF) / 255,
+            blue: CGFloat(hex & 0xFF) / 255,
+            alpha: 1,
+        )
+    }
+}
