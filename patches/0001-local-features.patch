+    func show(_ usage: ChatContextUsage) {
+        fraction = CGFloat(usage.fraction)
+        // a conversation with nothing in it has nothing to report; from the
+        // first message on, the line stays put
+        isHidden = usage.tokens <= 0
+        let tint: UIColor = usage.isCritical
+            ? .systemRed
+            : (usage.isLarge ? .systemOrange : .systemGreen)
+        backgroundColor = tint.withAlphaComponent(0.10)
+        track.backgroundColor = tint.withAlphaComponent(0.22)
+        fill.backgroundColor = tint
+        label.textColor = Self.ink(critical: usage.isCritical, large: usage.isLarge)
