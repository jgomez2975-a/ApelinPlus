+++ b/Apelin/Interface/Chats/ChatContextController.swift
@@ -0,0 +1,146 @@
+import ApelinProtocol
+import UIKit
+
+/// What the conversation is made of, by size.
+///
+/// The point is not the total — the bar under the navigation bar already says
+/// that — but which part is taking the room. A conversation that is almost
+/// all tool output wants one thing; one whose own replies are the bulk wants
+/// another.
+final class ChatContextController: TableController {
+    private let usage: ChatContextUsage
+    private let messageCount: Int
+
+    private enum Row: Hashable {
+        case amount
+        case bar
+        case part(ChatContextUsage.Kind)
+        case note
+    }
+
+    private enum Section: Hashable {
+        case head
+        case parts
+        case note
+    }
+
+    private lazy var dataSource = TableDataSource<Section, Row, Row>(
+        tableView: tableView,
+        identifier: { $0 },
+    ) { [weak self] _, _, row in
+        self?.cell(for: row)
+    }
+
+    init(usage: ChatContextUsage, messageCount: Int) {
+        self.usage = usage
+        self.messageCount = messageCount
+        super.init(style: .insetGrouped)
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        title = String(localized: "Context")
+        tableView.rowHeight = UITableView.automaticDimension
+        tableView.estimatedRowHeight = 48
+        rebuild()
+    }
+
+    private func rebuild() {
+        var sections: [(Section, [Row])] = [(.head, [.amount, .bar])]
+        let parts = ChatContextUsage.Kind.allCases.filter { (usage.byRole[$0] ?? 0) > 0 }
+        if !parts.isEmpty {
+            sections.append((.parts, parts.map(Row.part)))
+        }
+        sections.append((.note, [.note]))
+        dataSource.headerTitle = { section in
+            if case .parts = section {
+                return String(localized: "Messages")
+            }
+            return nil
+        }
+        dataSource.update(sections)
+    }
+
+    private func cell(for row: Row) -> UITableViewCell {
+        switch row {
+        case .amount: amountCell()
+        case .bar: barCell()
+        case let .part(kind): partCell(kind)
+        case .note: noteCell()
+        }
+    }
+
+    private func amountCell() -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+        var content = UIListContentConfiguration.cell()
+        content.text = usage.summary
+        content.textProperties.font = .systemFont(ofSize: 30, weight: .semibold)
+        content.textProperties.alignment = .center
+        content.directionalLayoutMargins = NSDirectionalEdgeInsets(top: 20, leading: 16, bottom: 4, trailing: 16)
+        cell.contentConfiguration = content
+        return cell
+    }
+
+    private func barCell() -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+
+        let bar = UIProgressView(progressViewStyle: .default)
+        bar.progress = Float(usage.fraction)
+        bar.trackTintColor = .tertiarySystemFill
+        bar.progressTintColor = usage.isCritical ? .systemRed : (usage.isLarge ? .systemOrange : .tintColor)
+        bar.layer.cornerRadius = 3
+        bar.layer.masksToBounds = true
+
+        bar.translatesAutoresizingMaskIntoConstraints = false
+        cell.contentView.addSubview(bar)
+        let margins = cell.contentView.layoutMarginsGuide
+        NSLayoutConstraint.activate([
+            bar.leadingAnchor.constraint(equalTo: margins.leadingAnchor),
+            bar.trailingAnchor.constraint(equalTo: margins.trailingAnchor),
+            bar.topAnchor.constraint(equalTo: margins.topAnchor),
+            bar.bottomAnchor.constraint(equalTo: margins.bottomAnchor, constant: -8),
+        ])
+        return cell
+    }
+
+    private func partCell(_ kind: ChatContextUsage.Kind) -> UITableViewCell {
+        let cell = UITableViewCell(style: .value1, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+        var content = UIListContentConfiguration.valueCell()
+        content.text = Self.title(of: kind)
+        content.secondaryText = ChatContextUsage.abbreviated(usage.byRole[kind] ?? 0)
+        content.secondaryTextProperties.color = .secondaryLabel
+        cell.contentConfiguration = content
+        return cell
+    }
+
+    private func noteCell() -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+        var content = UIListContentConfiguration.cell()
+        // said plainly, because a count that is near the limit and an
+        // estimate are two different reasons not to trust the number
+        content.text = String(localized: "Estimated")
+        content.textProperties.color = .secondaryLabel
+        content.textProperties.font = .preferredFont(forTextStyle: .footnote)
+        content.textProperties.alignment = .center
+        cell.contentConfiguration = content
+        return cell
+    }
+
+    private static func title(of kind: ChatContextUsage.Kind) -> String {
+        switch kind {
+        case .prompt: String(localized: "Prompt")
+        case .reply: String(localized: "Reply")
+        case .tool: String(localized: "Tools")
+        case .activity: String(localized: "Activity")
+        }
+    }
+}
diff --git a/Apelin/Interface/Chats/ChatContextUsage.swift b/Apelin/Interface/Chats/ChatContextUsage.swift
new file mode 100644
index 0000000..8822cd0
--- /dev/null
+++ b/Apelin/Interface/Chats/ChatContextUsage.swift
@@ -0,0 +1,86 @@
+import ApelinProtocol
+import Foundation
+
+/// How much of a model's window a conversation has taken.
+///
+/// The count is an estimate, not the tokenizer's: the app never sees the
+/// system prompt, the tool catalogue or the provider's own accounting, and
+/// asking the agent for them would need a round trip the page cannot wait
+/// on. `TokenEstimate` is the same four-characters-to-a-token guess the
+/// agent itself counts streamed output with, so a number from here and one
+/// from a run are at least measured the same way.
+///
+/// What it is good for is the shape: a conversation at 12% and one at 88%
+/// are visibly different, and that is what decides whether to compact.
+struct ChatContextUsage {
+    /// What the window is taken to be. kwwk's default for a model it does
+    /// not know.
+    static let window: Double = 128_000
+
+    let tokens: Double
+    /// What each kind of row contributes, for the inspector.
+    let byRole: [Kind: Double]
+
+    enum Kind: String, CaseIterable, Hashable {
+        case prompt
+        case reply
+        case tool
+        case activity
+    }
+
+    var fraction: Double {
+        min(1, tokens / Self.window)
+    }
+
+    var isLarge: Bool { fraction >= 0.75 }
+    var isCritical: Bool { fraction >= 0.9 }
+
+    static func measure(_ messages: [ChatMessage]) -> ChatContextUsage {
+        var byRole: [Kind: Double] = [:]
+        var total: Double = 0
+        for message in messages {
+            let counted = Self.cost(of: message)
+            guard counted > 0 else { continue }
+            total += counted
+            byRole[Self.kind(of: message.role), default: 0] += counted
+        }
+        return ChatContextUsage(tokens: total, byRole: byRole)
+    }
+
+    /// One row, and whatever its trace holds: a summary's tool calls are
+    /// sent with it, so they count with it.
+    private static func cost(of message: ChatMessage) -> Double {
+        var total = TokenEstimate.tokens(in: message.text)
+        if !message.detail.isEmpty {
+            total += TokenEstimate.tokens(in: message.detail)
+        }
+        for entry in message.trace {
+            total += cost(of: entry)
+        }
+        return total
+    }
+
+    private static func kind(of role: ChatMessage.Role) -> Kind {
+        switch role {
+        case .user: .prompt
+        case .assistant: .reply
+        case .tool: .tool
+        case .thinking, .approval, .compaction: .activity
+        }
+    }
+
+    /// `18.4k` — a count at the size a reader compares, not reads.
+    static func abbreviated(_ tokens: Double) -> String {
+        if tokens >= 1000 {
+            let thousands = tokens / 1000
+            return thousands >= 100
+                ? "\(Int(thousands.rounded()))k"
+                : String(format: "%.1fk", thousands)
+        }
+        return "\(Int(tokens.rounded()))"
+    }
+
+    var summary: String {
+        "\(Self.abbreviated(tokens)) / \(Self.abbreviated(Self.window))"
+    }
+}
