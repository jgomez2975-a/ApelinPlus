+
+/// A pill with its own padding, which a plain `UILabel` does not have.
+///
+/// `intrinsicContentSize` is overridden rather than the label being wrapped in
+/// a view, so a cell can size itself from one constraint.
+final class ProviderPillLabel: UILabel {
+    var insets = UIEdgeInsets(top: 3, left: 7, bottom: 3, right: 7) {
+        didSet { invalidateIntrinsicContentSize() }
+    }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        font = .systemFont(ofSize: 11.5, weight: .semibold)
+        adjustsFontForContentSizeCategory = false
+        layer.cornerRadius = 6
+        layer.cornerCurve = .continuous
+        layer.masksToBounds = true
+        textAlignment = .center
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func drawText(in rect: CGRect) {
+        super.drawText(in: rect.inset(by: insets))
+    }
+
+    override var intrinsicContentSize: CGSize {
+        let size = super.intrinsicContentSize
+        return CGSize(
+            width: size.width + insets.left + insets.right,
+            height: max(20, size.height + insets.top + insets.bottom),
+        )
+    }
+
+    override func sizeThatFits(_ size: CGSize) -> CGSize {
+        let fitted = super.sizeThatFits(size)
+        return CGSize(
+            width: fitted.width + insets.left + insets.right,
+            height: max(20, fitted.height + insets.top + insets.bottom),
+        )
+    }
