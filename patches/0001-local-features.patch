+    private static func dot(_ tone: ProviderTint.Tone, ringed: Bool = false) -> UIImage {
+        let size = CGSize(width: 30, height: 30)
+        let image = UIGraphicsImageRenderer(size: size).image { context in
+            let inset: CGFloat = ringed ? 4 : 1
+            let rect = CGRect(origin: .zero, size: size).insetBy(dx: inset, dy: inset)
+            let path = UIBezierPath(ovalIn: rect)
+            context.cgContext.saveGState()
+            path.addClip()
+            let colours = [tone.top.cgColor, tone.bottom.cgColor] as CFArray
+            if let gradient = CGGradient(
+                colorsSpace: CGColorSpaceCreateDeviceRGB(),
+                colors: colours,
+                locations: [0, 1],
+            ) {
+                context.cgContext.drawLinearGradient(
+                    gradient,
+                    start: CGPoint(x: 0, y: 0),
+                    end: CGPoint(x: size.width, y: size.height),
+                    options: [],
+                )
+            }
+            context.cgContext.restoreGState()
+            if ringed {
+                UIColor.label.setStroke()
+                let ring = UIBezierPath(ovalIn: rect.insetBy(dx: -3, dy: -3))
+                ring.lineWidth = 2
