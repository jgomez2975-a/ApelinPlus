diff --git a/Configuration/Version.xcconfig b/Configuration/Version.xcconfig
index 068eb46..2e25413 100644
--- a/Configuration/Version.xcconfig
+++ b/Configuration/Version.xcconfig
@@ -4,6 +4,11 @@
 // A target-level MARKETING_VERSION / CURRENT_PROJECT_VERSION in
 // project.pbxproj silently shadows these and ships the wrong build number —
 // `make check` rejects that; keep it that way.
+//
+// A local build: upstream 0.4.8 does not exist. The number is above 0.4.7 on
+// purpose, so `dpkg -i` and Irisin take this package as an upgrade over the
+// release it was patched from instead of refusing a reinstall of the same
+// version. Change it back if this ever merges upstream.
 
-MARKETING_VERSION = 0.4.7
-CURRENT_PROJECT_VERSION = 40
+MARKETING_VERSION = 0.4.8
+CURRENT_PROJECT_VERSION = 41
